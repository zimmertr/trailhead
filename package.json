{
  "name": "trailhead",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "content",
    "common",
    "web",
    "api",
    "admin",
    "fetcher",
    "e2e"
  ],
  "scripts": {
    "content": "npm run build -w content",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts --coverage",
    "openapi": "node api/scripts/openapi.ts",
    "check:openapi": "node api/scripts/openapi.ts --check",
    "unused": "knip"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "0.28.2",
    "knip": "6.45.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
